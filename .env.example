# Auth (NextAuth v5)
AUTH_SECRET=your-secret-here-run-openssl-rand-base64-32
AUTH_GITHUB_ID=your-github-oauth-app-id
AUTH_GITHUB_SECRET=your-github-oauth-app-secret
NEXTAUTH_URL=https://yourdomain.com
ABSURD_DOMAIN=yourdomain.com

# Database — used by both the web container and the db container
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_DB=absurd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# First admin (GitHub username — bypasses invite check)
ADMIN_GITHUB_USERNAME=your-github-username

# Auth (NextAuth v5)
AUTH_SECRET=your-secret-here-run-openssl-rand-base64-32
AUTH_GITHUB_ID=your-github-oauth-app-id
AUTH_GITHUB_SECRET=your-github-oauth-app-secret
NEXTAUTH_URL=http://localhost:3000

# Database
POSTGRES_URL=postgresql://postgres:password@localhost:5432/absurd
POSTGRES_PASSWORD=password

# First admin (GitHub username — this user bypasses invite check)
ADMIN_GITHUB_USERNAME=your-github-username
